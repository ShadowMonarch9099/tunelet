{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunelet",
  "version": "0.6.0",
  "identifier": "com.tunelet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tunelet",
        "width": 96,
        "height": 96,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "publisher": "ShadowMonarch9099",
    "homepage": "https://github.com/ShadowMonarch9099/tunelet",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "shortDescription": "Spotify mini-player",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzQjJDMDQxRUZGQTk2MjUKUldRbGx2cnZRY0N5QS95ZlpFZkEzS0xCcXRmMjRvUWZmajJmSkZBcnNILzN0RWRXTkhXV1FTUUYK",
      "endpoints": [
        "https://github.com/ShadowMonarch9099/tunelet/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
