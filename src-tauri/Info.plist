<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Shown when macOS asks whether Tunelet may control Spotify (AppleScript). -->
  <key>NSAppleEventsUsageDescription</key>
  <string>Tunelet controls the Spotify app to show what's playing and to play, pause and skip songs.</string>
  <!-- Background app: no Dock icon. -->
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
